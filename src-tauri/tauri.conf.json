{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "game-25",
	"version": "0.1.0",
	"identifier": "com.ozon.bank.dev",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:3000",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build:site"
	},
	"app": {
		"windows": [
			{
				"title": "game-25",
				"width": 1280,
				"height": 800,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all"
	}
}
