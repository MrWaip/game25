{
	"name": "game-25",
	"version": "0.0.0",
	"private": true,
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./style.css": "./dist/style.css",
		"./defense": {
			"types": "./dist/defense.d.ts",
			"import": "./dist/defense.js"
		},
		"./arcade": {
			"types": "./dist/arcade.d.ts",
			"import": "./dist/arcade.js"
		}
	},
	"scripts": {
		"dev": "vp dev",
		"build:site": "vp build",
		"build:lib": "vp pack && cp src/style.css dist/style.css",
		"preview": "vp preview",
		"lint": "vp lint src --deny-warnings",
		"format": "vp fmt",
		"check": "vp check src",
		"smoke": "npm run check && npm test && npm run build:lib",
		"test": "vp test run --project unit",
		"test:stress": "NODE_OPTIONS=--expose-gc vp test run --project stress",
		"test:browser": "playwright test"
	},
	"dependencies": {
		"@timohausmann/quadtree-ts": "2.3.0",
		"gl-matrix": "3.4.4"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/node": "22.20.2",
		"happy-dom": "20.14.5",
		"typescript": "7.0.2",
		"vite-plus": "0.3.2"
	},
	"engines": {
		"node": "^22.18.0 || ^24.11.0 || >=26.0.0"
	}
}
